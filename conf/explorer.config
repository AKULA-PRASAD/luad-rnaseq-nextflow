// Northeastern Explorer cluster (SLURM + Apptainer).
// The STAR biocontainer's binaries crash with "Illegal instruction" on some Explorer
// CPU types, so the two STAR steps use the cluster's own STAR 2.7.11b module instead;
// every other step still runs in its pinned container.
process {
    executor = 'slurm'
    queue    = { params.slurm_queue }
    withName: 'STAR_INDEX|STAR_ALIGN' {
        container = null
        module    = 'star/2.7.11b'
    }
}
// Explorer's scheduler intermittently rejects sbatch with "Unexpected message received".
// A gentler submit rate and submit retries reduce, but did not remove, such failures in
// practice; when they persist, use the single-node profile (explorer_node) instead.
executor {
    queueSize       = 20
    submitRateLimit = '10/1min'
    retry {
        maxAttempt = 5
        delay      = '30s'
        maxDelay   = '5m'
        reason     = 'Unexpected message received|Socket timed out|Unable to contact slurm controller'
    }
}
singularity.enabled    = true
singularity.autoMounts = true
