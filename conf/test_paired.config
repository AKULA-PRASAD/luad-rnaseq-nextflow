// Paired-end, multi-run, matched-pair test data (see tests/make_test_data.py):
// 3 patients x (Normal, Tumor), 2 runs per sample, design ~ patient + condition.
params {
    samplesheet     = "${projectDir}/tests/data_paired/samplesheet.csv"
    genome          = "${projectDir}/tests/data/genome.fa"
    gtf             = "${projectDir}/tests/data/genes.gtf"
    batch_column    = 'patient'
    sa_index_nbases = 6
    sjdb_overhang   = 26
    gsea_gmt        = "${projectDir}/tests/data/genesets.gmt"
    gsea_min_size   = 3
    outdir          = 'results_test_paired'
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
