// Small synthetic dataset with planted differential expression (see tests/make_test_data.py).
// Runs in a few minutes on a laptop or a GitHub Actions runner.
params {
    samplesheet     = "${projectDir}/tests/data/samplesheet.csv"
    genome          = "${projectDir}/tests/data/genome.fa"
    gtf             = "${projectDir}/tests/data/genes.gtf"
    sa_index_nbases = 6
    sjdb_overhang   = 26
    outdir          = 'results_test'
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
