// Northeastern Explorer, single-node mode: the whole pipeline runs inside ONE SLURM
// allocation (hpc/run_pipeline_node.sbatch) with Nextflow's local executor, so no
// per-step sbatch submissions are made. Use this when the scheduler is unreliable.
// STAR steps use the cluster's STAR module (the biocontainer crashes on some CPUs).
process {
    executor = 'local'
    withName: 'STAR_INDEX|STAR_ALIGN' {
        container = null
        module    = 'star/2.7.11b'
    }
}
// Must match the sbatch request (--cpus-per-task=16, --mem=100G), leaving headroom.
executor {
    cpus   = 16
    memory = '90 GB'
}
singularity.enabled    = true
singularity.autoMounts = true
