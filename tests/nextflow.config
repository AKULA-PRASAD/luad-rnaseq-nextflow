// Settings for nf-test runs (see nf-test.config).
process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    // On Apple Silicon, run the amd64 biocontainers under Rosetta:
    //   NFT_PLATFORM=linux/amd64 nf-test test
    containerOptions = System.getenv('NFT_PLATFORM') ? "--platform ${System.getenv('NFT_PLATFORM')}" : ''
}
