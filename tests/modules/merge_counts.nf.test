nextflow_process {
    name    "MERGE_COUNTS"
    script  "../../modules/merge_counts.nf"
    process "MERGE_COUNTS"
    tag     "modules"

    test("auto strandedness: unstranded library, matrix matches the fixture") {
        when {
            process {
                """
                input[0] = files("${projectDir}/tests/fixtures/star/*.ReadsPerGene.out.tab")
                input[1] = file("${projectDir}/tests/data/genes.gtf", checkIfExists: true)
                input[2] = 'auto'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.matrix[0]).md5 == path("${projectDir}/tests/fixtures/counts_matrix.csv").md5 },
                { assert path(process.out.strandedness[0]).text.contains("# used\tunstranded") },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("explicit --strandedness reverse uses STAR's fourth column") {
        when {
            process {
                """
                input[0] = files("${projectDir}/tests/fixtures/star/*.ReadsPerGene.out.tab")
                input[1] = file("${projectDir}/tests/data/genes.gtf", checkIfExists: true)
                input[2] = 'reverse'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.strandedness[0]).text.contains("# used\treverse") },
                { assert path(process.out.matrix[0]).md5 != path("${projectDir}/tests/fixtures/counts_matrix.csv").md5 }
            )
        }
    }
}
