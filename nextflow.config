manifest {
    name            = 'luad-rnaseq-nextflow'
    author          = 'Prasad Akula'
    description     = 'RNA-seq pipeline (FastQC, STAR, DESeq2) for lung adenocarcinoma tumour vs normal'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    samplesheet     = null        // CSV: sample,condition,fastq_1[,fastq_2,run,<batch>]; one row per run
    genome          = null        // genome FASTA (.fa or .fa.gz)
    gtf             = null        // annotation GTF (.gtf or .gtf.gz)
    star_index      = null        // optional prebuilt STAR index (skips STAR_INDEX)
    sjdb_overhang   = 77          // read length - 1 (2 x 78 bp reads in GSE37764)
    sa_index_nbases = 14          // 14 for human; small genomes need less (see test profile)
    strandedness    = 'auto'      // auto | unstranded | forward | reverse
    star_simd       = null        // container only: force a STAR build (sse4.1, avx, avx2) on mixed-CPU clusters
    reference_level = 'Normal'    // DESeq2 reference condition
    batch_column    = null        // samplesheet column added to the design (e.g. patient): ~ batch + condition
    padj            = 0.05
    outdir          = 'results'
    slurm_queue     = 'short'
}

process {
    cpus   = 1
    memory = 2.GB
    time   = 2.h
    withLabel: process_low    { cpus = 2; memory = 4.GB;  time = 2.h }
    withLabel: process_medium { cpus = 4; memory = 16.GB; time = 4.h }
    withLabel: process_high   { cpus = 8; memory = 42.GB; time = 8.h }   // as used on the HPC for STAR

    withName: FASTQC       { publishDir = [path: { "${params.outdir}/fastqc" },  mode: 'copy'] }
    withName: STAR_INDEX   { publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy', enabled: false] }
    withName: STAR_ALIGN   { publishDir = [path: { "${params.outdir}/star" },    mode: 'copy'] }
    withName: MERGE_COUNTS { publishDir = [path: { "${params.outdir}/counts" },  mode: 'copy'] }
    withName: DESEQ2       { publishDir = [path: { "${params.outdir}/deseq2" },  mode: 'copy'] }
    withName: MULTIQC      { publishDir = [path: { "${params.outdir}/multiqc" }, mode: 'copy'] }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
        conda.useMamba = true
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = { params.slurm_queue }
        executor.queueSize = 20
    }
    explorer { includeConfig 'conf/explorer.config' }
    explorer_node { includeConfig 'conf/explorer_node.config' }
    test        { includeConfig 'conf/test.config' }
    test_paired { includeConfig 'conf/test_paired.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
